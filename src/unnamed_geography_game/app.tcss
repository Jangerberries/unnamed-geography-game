UnnamedBordersGame > Middle {
       height: 100%;
       border: solid red;
       margin: 0 0;
       padding: 0 0;
       border: tall $background

}

Vertical > Horizontal > Input {
      height: auto;
      width: 1fr;
      content-align: center middle;
      margin: 0 1;
}

Vertical > Static {
      height: 5;
      width: 100%;
      content-align: center middle;
}



Grid.countrygrid {
	    grid-size: 1;
	    margin: 0 0;
	    grid-rows: auto;
	    height: auto;
}

/* In progress country stuff */

CountryCard {
	    background: $panel-darken-1;
	    height: auto;
/*	    margin: 1 0 0 0;
	    padding: 0 0 1 0; */
}

CountryCard > Input {
	    height: 3;
/*	    margin: 0 1 1 1; */
}

VerticalScroll #in_progress {
/* 	       padding: 1 */
}

GameOverPopup {
	align: center middle;
}


/* Completed countries stuff */

DoneCountryList {
		grid-size: 2;
}

DoneCountryList > RegionList {
		margin: 1;
		height: auto
}


/* Game over popup stuff */

GameOverPopup > Grid {
	    grid-size: 2;
	    grid-gutter: 1 2;
            grid-rows: 1fr 3;
    	    background: $surface;
	    align: center middle;
	    height: 11;
	    width: 60;
	    padding: 1;
	    border: round $background-darken-1;
	    background: $boost;
}

GameOverPopup > Grid > Label {
	      column-span: 2;
	      height: 1fr;
	      width: 1fr;
	      align: center middle;
	      content-align: center middle;
}

GameOverPopup > Grid > Button {
	      width: 100%;
	      column-span: 2;
}